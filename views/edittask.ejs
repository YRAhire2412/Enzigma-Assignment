</head>

<body>
    <form action="/updatetask" method="post">
        Task Id : <input type="text" name="tid" id="tid" value="<%=task.tid%>" readonly><br>

        Assigned TO: <input type="text" name="AssignedTo" id="AssignedTo" value="<%=task.AssignedTo%>"><br>
